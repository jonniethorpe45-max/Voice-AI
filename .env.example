ENVIRONMENT=local
APP_NAME=Surplus Recovery Ops API
DEBUG=true
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/surplus_ops
REDIS_URL=redis://redis:6379/0

JWT_SECRET_KEY=change-me-access-secret
JWT_REFRESH_SECRET_KEY=change-me-refresh-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=20160

SEED_ADMIN_EMAIL=admin@surplus.local
SEED_ADMIN_PASSWORD=admin123456

LOB_API_KEY=
LOB_BASE_URL=https://api.lob.com/v1
TWILIO_WEBHOOK_TOKEN=
INBOUND_EMAIL_SECRET=

CORS_ORIGINS=http://localhost:3000,http://localhost:8080,*
TWILIO_WEBHOOK_TOKEN=
INBOUND_EMAIL_SECRET=
