VOCALFIT_APP_NAME=VocalFit AI API
VOCALFIT_APP_VERSION=0.1.0

# Redis
VOCALFIT_REDIS_URL=redis://localhost:6379/0

# Storage
VOCALFIT_STORAGE_ROOT=/workspace/data
VOCALFIT_MODEL_ROOT=/workspace/models
VOCALFIT_UPLOAD_SUBDIR=uploads
VOCALFIT_OUTPUT_SUBDIR=outputs

# Runtime / pipeline toggles
VOCALFIT_USE_GPU=false
VOCALFIT_USE_DEMUCS=true
VOCALFIT_WORKER_CAPABILITY=cpu

# Upload + queue behavior
VOCALFIT_MAX_FILE_SIZE_MB=150
VOCALFIT_QUEUE_CPU_NAME=vocalfit:jobs:cpu
VOCALFIT_QUEUE_GPU_NAME=vocalfit:jobs:gpu
VOCALFIT_QUEUE_DEAD_LETTER_NAME=vocalfit:jobs:dead
VOCALFIT_QUEUE_BLOCK_SECONDS=2
VOCALFIT_MAX_JOB_RETRIES=2

# CORS (comma-separated)
VOCALFIT_CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8080,http://localhost:5173
